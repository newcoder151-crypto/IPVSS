# ---------------------------------------------------------------------------
# mNVR <-> CMS bridge. Copy to .env and edit. Only the first two blocks are needed.
# ---------------------------------------------------------------------------

# CMS this train reports to, and this unit's identity (the certificate fingerprint CMS has registered for it)
CMS_URL=http://localhost:7080
NVR_FINGERPRINT=

# The M-NVR's own PostgreSQL database (read-only access is enough, see scripts/grant_readonly.sql)
MNVR_DB_HOST=localhost
MNVR_DB_PORT=5432
MNVR_DB_NAME=mnvr
MNVR_DB_USER=mnvr_bridge
MNVR_DB_PASSWORD=

# --- optional -------------------------------------------------------------
# Folder holding the M-NVR recordings (only to report disk usage in the heartbeat)
# RECORDINGS_DIR=/storage/recordings
# Camera mapping when names differ:  mNVR camera id : CMS camera id
# CAMERA_MAP=1:10,2:11
# Status page (loopback only); 0 disables
# STATUS_PORT=8095

# Heartbeat / GPS
# HEARTBEAT_S=5
# GPS_TRACK_MIN_INTERVAL_S=5

# Alerts: position used when the unit has no GPS fix at all (otherwise such an alert cannot be routed and is logged)
# FALLBACK_LAT=
# FALLBACK_LON=
# ALERT_GPS_WAIT_S=30
# ALERT_RULES_FILE=./config/alert-rules.json

# Footage upload
# CHUNK_BYTES=1048576
# UPLOAD_MAX_KBPS=0            # cap the 5G upload rate, 0 = unlimited
# UPLOAD_CONCURRENCY=2

# Push footage around serious alerts BEFORE anyone asks (uses mobile data; off by default)
# AUTO_UPLOAD_ON_ALERT=0
# AUTO_UPLOAD_PRE_S=60
# AUTO_UPLOAD_POST_S=60
# AUTO_UPLOAD_MIN_PRIORITY=7

# --- automatic registration (the bridge registers this M-NVR in CMS by itself) ---
# Needs the CMS database login. Unit name + train number are read from the M-NVR (system_config).
# CMS_DB_HOST=localhost
# CMS_DB_NAME=cms
# CMS_DB_USER=cms
# CMS_DB_PASSWORD=
# ZONE=Zone 1            # default: first zone in CMS
# NVR_NAME= / TRAIN_NO=  # only to override what the M-NVR says
