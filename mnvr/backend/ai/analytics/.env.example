# Copy to .env (same folder). Never commit the real one.
API_URL=http://localhost:3001
# Create the account first:  cd backend/api && node create-service-user.js analytics-worker "<long password>"
ANALYTICS_USER=analytics-worker
ANALYTICS_PASS=change-me-use-a-long-random-password
# start.sh passes API_URL / MEDIAMTX_RTSP / STORAGE_PATH itself; these only matter when you run worker.py by hand.
MEDIAMTX_RTSP=localhost:8554
# Must equal the API's STORAGE_PATH (API default: /storage)
STORAGE_PATH=/storage
# Cap CPU threads torch may use so the API/stream-manager/sidecar aren't starved (0 = torch default)
TORCH_THREADS=2
POLL_CONFIG_SECS=30
