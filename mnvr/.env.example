# =============================================================================
# Railway mNVR — environment template
#
# Copy the relevant sections into the per-workspace .env files:
#   backend/api/.env   ← database, auth, storage, service URLs
#   frontend/.env      ← VITE_* values only (these are exposed to the browser)
#
# start.sh creates both with sensible localhost defaults on first run.
# Never commit the resulting .env files.
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mnvr
DB_USER=mnvr
DB_PASSWORD=change-me

# ── API ──────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Generate a strong value for production, e.g.  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h

# ── Storage ──────────────────────────────────────────────────────────────────
# Recordings, HLS segments, and search thumbnails are written beneath this root.
STORAGE_PATH=/storage

# ── Service endpoints ────────────────────────────────────────────────────────
YOLO_SIDECAR_URL=http://localhost:8000
MEDIAMTX_API=http://localhost:9997
MEDIAMTX_RTSP=localhost:8554

# ── Smart Search indexer ─────────────────────────────────────────────────────
SAMPLE_INTERVAL_SECS=2
POLL_CAMERAS_SECS=30
INDEXER_DETECT_CONF=0.45
INDEXER_MAX_PEOPLE_PER_FRAME=5

# ── Frontend (browser-visible — never put secrets in VITE_* vars) ────────────
VITE_API_URL=http://localhost:3001
