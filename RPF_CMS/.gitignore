
# Dependencies
**/node_modules/

# Environment variables and secrets
**/.env
**/.env.*
!**/.env.example
!**/.env.sample

# Logs
**/logs/
**/*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Runtime files and process IDs
**/run/
**/*.pid
**/*.pid.lock

# Python cache and virtual environments
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.venv/
**/venv/
**/env/

# Test and coverage output
**/coverage/
**/.nyc_output/
**/test-results/
**/playwright-report/

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Temporary files
**/tmp/
**/temp/
*.tmp
*.bak

# Local databases and generated database files
**/*.sqlite
**/*.sqlite3
**/*.db

# Generated media and recordings
**/media/
**/recordings/
**/captures/

# Browser test screenshots (generated output)
# Uncomment if you do not want to version these screenshots:
 CMS/test/browser/shots/
rpf/test/browser/shots/
# Keep package manifests and lockfiles tracked
 package.json
 package-lock.json
