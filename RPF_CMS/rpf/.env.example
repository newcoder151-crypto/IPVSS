# ---- Database: SAME database as CMS (no separate RPF database) ----------
# Use the CMS values, or better, a dedicated least-privilege role created
# from sql/rpf_app_role.sql (see README).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cms
DB_USER=cms
DB_PASSWORD=changeme

# ---- Stack launcher (scripts/start.sh) ------------------------------------
# Folder containing the CMS code (sql/ and backend/). Default: ../CMS next to rpf.
#CMS_DIR=../CMS
CMS_PORT=7080
# Alerts at or above this priority are auto-dispatched by CMS.
PRIORITY_THRESHOLD=7
# Used only to create the role/database on first run, when the script cannot
# reach Postgres via sudo/su. Leave blank on a normal local install.
PG_SUPERUSER=postgres
#PG_SUPERUSER_PASSWORD=
# 1 = run the RPF server as the least-privilege 'rpf_app' role (needs a superuser once).
RPF_LEAST_PRIVILEGE=0
# Create this month's and the next N months' alert/gps_point partitions at start-up.
ENSURE_PARTITIONS=1
PARTITION_MONTHS_AHEAD=3

# ---- RPF server ---------------------------------------------------------
PORT=7090
# REQUIRED. Long random string used to sign login tokens and footage links.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_HOURS=8

# ---- Footage -------------------------------------------------------------
# delivered_footage.storage_path is resolved relative to this directory
# (absolute paths are accepted only if they sit inside it).
MEDIA_ROOT=./media
# How long a view/download link stays valid.
FOOTAGE_LINK_MINUTES=15

# ---- Request / flag rules -----------------------------------------------
# Longest footage window a post may request in one go.
MAX_REQUEST_WINDOW_MIN=240
# Default retention offered when flagging footage.
DEFAULT_RETENTION_DAYS=365

# ---- Alert feed -----------------------------------------------------------
# The browser polls for new alerts at this interval (CMS schema has no
# NOTIFY trigger and RPF must not add one).
ALERT_POLL_SECONDS=5

# CMS console session/footage-link signing secret (start.sh generates one). 32+ random characters.
CMS_JWT_SECRET=
# Demo only: 1 = CMS approves footage requests automatically (normally an operator approves each).
AUTO_APPROVE_REQUESTS=0
# Demo only: the simulated trains raise a random alert about every N seconds (0 = none).
SIM_ALERT_EVERY=90
# Use vp9 if your browser cannot play H.264 (e.g. stock Chromium).
SIM_CODEC=h264

# Where this post keeps recordings the officer chose to store locally (not deleted automatically).
LOCAL_EVIDENCE_DIR=./local-evidence
