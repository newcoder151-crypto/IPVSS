# Database connection - same values as the project root .env
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cms
DB_USER=cms
DB_PASSWORD=changeme

PORT=7080
# Signs console sessions and footage links. 32+ random characters; unset = random per start.
CMS_JWT_SECRET=
# Footage store (stand-in for object storage). The RPF server must read the same folder.
MEDIA_ROOT=../media

# Alerts at or above this priority are auto-dispatched (nearest post + incident). Below it they
# wait in the operator queue. Also editable at runtime in the console (Settings).
PRIORITY_THRESHOLD=7
ESCALATION_MINUTES=10
# 1 = approve footage requests automatically (demo only; normally an operator approves each one)
AUTO_APPROVE_REQUESTS=0
# 0 = do not start background workers in this process
CMS_WORKERS=1
# Original unauthenticated /api/alerts endpoints (dev). Off by default in production.
LEGACY_API=1
